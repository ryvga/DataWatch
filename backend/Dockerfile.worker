# Same build stages as Dockerfile.api — only CMD differs
FROM python:3.12-slim-bookworm AS deps

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev unixodbc-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

FROM python:3.12-slim-bookworm AS app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl gnupg libgssapi-krb5-2 libpq5 \
    && curl -fsSLo /tmp/packages-microsoft-prod.deb \
      https://packages.microsoft.com/config/debian/12/packages-microsoft-prod.deb \
    && dpkg -i /tmp/packages-microsoft-prod.deb \
    && rm /tmp/packages-microsoft-prod.deb \
    && apt-get update \
    && ACCEPT_EULA=Y apt-get install -y --no-install-recommends msodbcsql18 \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -r datawatch && useradd -r -g datawatch datawatch

WORKDIR /app

COPY --from=deps /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=deps /usr/local/bin /usr/local/bin

COPY --chown=datawatch:datawatch . .

USER datawatch

CMD ["celery", "-A", "app.worker", "worker", "--loglevel=info", "--concurrency=4"]
